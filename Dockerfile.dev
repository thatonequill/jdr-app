# Use Node 22 to satisfy @prisma/streams-local requirements
FROM node:22-alpine

# Prisma on Alpine needs openssl and libc6-compat
RUN apk add --no-cache postgresql-client openssl libc6-compat 

WORKDIR /app 

# Copy dependency files first for better caching
COPY package.json package-lock.json* ./ 

# IMPORTANT: Install dependencies BEFORE copying the rest of the code.
# This ensures that 'prisma/config' is available for the next steps.
RUN npm install 

# Copy configuration and schema
COPY prisma.config.ts tsconfig.json ./ 
COPY prisma ./prisma 
COPY files/ ./files/ 

# Run generate during build to ensure the client is baked into the image
RUN npx prisma generate

# Ensure the start script is executable
RUN chmod +x ./files/start.sh

CMD ["sh", "./files/start.sh"]